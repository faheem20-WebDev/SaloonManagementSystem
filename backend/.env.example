# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://user:pass@localhost:5432/luxe_db

# Security
JWT_SECRET=your_super_secret_jwt_key_here

# Stripe Payment Gateway
# Get these from your Stripe Dashboard -> Developers -> API Keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email Configuration
# Option A: Official Gmail REST API over HTTPS Port 443 (Recommended for Hugging Face Spaces & firewalled cloud hosts)
# GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
# GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token

# Option B: Gmail SMTP via Port 465 (Supported on hosts allowing outbound SMTP)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password
EMAIL_FROM=your-email@gmail.com

# Client URL (for password reset links and CORS)
CLIENT_URL=https://saloon-management-system-fzc0l8s4e-faheem-s-projects-4830cc72.vercel.app
FRONTEND_URL=https://saloon-management-system-neon.vercel.app
